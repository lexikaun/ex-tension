{
  "manifest_version": 3,
  "name": "Ex-Tension Media Controller",
  "version": "1.1.0",
  "description": "Universal audio boost and playback speed controller for all HTML5 media.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Media Controls"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "storage.js",
        "adapters/site-adapters.js",
        "video-finder.js",
        "controller.js",
        "hotkeys.js",
        "overlay-ui.js",
        "media-session.js",
        "mini-player.js",
        "player-ui.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
