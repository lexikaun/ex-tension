{
  "manifest_version": 3,
  "name": "InstaPlayer Pro",
  "version": "1.0.0",
  "description": "Advanced video playback control for Instagram.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "permissions": [
    "storage",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": [
        "video-finder.js",
        "controller.js",
        "hotkeys.js",
        "overlay-ui.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
