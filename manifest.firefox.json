{
  "manifest_version": 3,
  "name": "InstaPlayer Pro",
  "version": "1.0.0",
  "description": "Advanced video playback control for HTML5 video platforms.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Controls"
  },
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "storage",
    "scripting"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "instaplayer@lexikaun.github.io",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "storage.js",
        "adapters/site-adapters.js",
        "video-finder.js",
        "controller.js",
        "hotkeys.js",
        "overlay-ui.js",
        "media-session.js",
        "mini-player.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
